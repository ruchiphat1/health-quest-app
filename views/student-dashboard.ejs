<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Dashboard - Health Quest</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-indigo-50 min-h-screen pb-12">
    <!-- Header ส่วนหัวของนักเรียน -->
    <div class="bg-indigo-600 text-white p-4 rounded-b-3xl shadow-lg max-w-md mx-auto">
        <div class="flex items-center gap-4">
            
            <!-- รูปโปรไฟล์ พร้อมไอคอน + -->
            <form action="/student/update-profile-pic" method="POST" enctype="multipart/form-data" class="relative group cursor-pointer">
                <div class="relative w-16 h-16">
                    <img src="<%= user.profile_img %>" class="w-16 h-16 rounded-full border-2 border-white object-cover">
                    <!-- วงกลมไอคอน + -->
                    <div class="absolute bottom-0 right-0 bg-yellow-400 text-gray-900 rounded-full w-5 h-5 flex items-center justify-center text-sm font-bold border-2 border-white shadow">
                        +
                    </div>
                </div>
                <input type="file" name="profile_pic" onchange="this.form.submit()" class="absolute inset-0 opacity-0 cursor-pointer" title="คลิกเพื่อเปลี่ยนรูปโปรไฟล์">
            </form>
            
            <div>
                <h1 class="font-bold text-lg"><%= user.fullname %></h1>
                <!-- แสดงรหัสนักเรียน -->
                <p class="text-xs text-indigo-200">รหัส: <%= user.student_id || '-' %> | <%= user.grade_level %> <%= user.room %></p>
                <span class="inline-block bg-indigo-800 text-yellow-300 text-xs px-2 py-0.5 rounded-full font-bold mt-1">
                    Level <%= user.level %>
                </span>
            </div>
        </div>

        <!-- แถบพลัง EXP Bar -->
        <div class="mt-4">
            <div class="flex justify-between text-xs mb-1">
                <span>EXP</span>
                <span><%= user.exp %> / <%= expRequired %></span>
            </div>
            <div class="w-full bg-indigo-900 rounded-full h-3 overflow-hidden">
                <div class="bg-yellow-400 h-3 rounded-full transition-all duration-300" style="width: <%= (user.exp / expRequired) * 100 %>%"></div>
            </div>
        </div>
    </div>

    <!-- ส่วนแสดง Status -->
    <div class="max-w-md mx-auto p-4 space-y-4">
<!-- การ์ดแสดงเหรียญเกียรติยศ -->
<div class="bg-white p-5 rounded-3xl shadow-xl mt-4">
    <h3 class="font-extrabold text-gray-800 text-base mb-4 flex items-center gap-2">
        🏆 เหรียญรางวัล (Badges)
    </h3>
    <div class="grid grid-cols-2 gap-3">
        <!-- เหรียญที่ 1 -->
        <div class="p-3 rounded-2xl border text-center <%= user.points >= 50 ? 'bg-amber-50 border-amber-300' : 'bg-gray-50 border-gray-200 opacity-60' %>">
            <div class="text-3xl mb-1"><%= user.points >= 50 ? '🥉' : '🔒' %></div>
            <div class="font-bold text-sm text-gray-800">สายสตรอง</div>
            <div class="text-[10.5px] text-gray-500 mt-1">สะสม 50 แต้ม</div>
        </div>
        <!-- เหรียญที่ 2 -->
        <div class="p-3 rounded-2xl border text-center <%= user.points >= 150 ? 'bg-slate-50 border-slate-300' : 'bg-gray-50 border-gray-200 opacity-60' %>">
            <div class="text-3xl mb-1"><%= user.points >= 150 ? '🥈' : '🔒' %></div>
            <div class="font-bold text-sm text-gray-800">นักล่าภารกิจ</div>
            <div class="text-[10.5px] text-gray-500 mt-1">สะสม 150 แต้ม</div>
        </div>
        <!-- เหรียญที่ 3 -->
        <div class="p-3 rounded-2xl border text-center <%= user.points >= 300 ? 'bg-yellow-50 border-yellow-300' : 'bg-gray-50 border-gray-200 opacity-60' %>">
            <div class="text-3xl mb-1"><%= user.points >= 300 ? '🥇' : '🔒' %></div>
            <div class="font-bold text-sm text-gray-800">ยอดมนุษย์สุขภาพ</div>
            <div class="text-[10.5px] text-gray-500 mt-1">สะสม 300 แต้ม</div>
        </div>
        <!-- เหรียญที่ 4 -->
        <div class="p-3 rounded-2xl border text-center <%= user.points >= 500 ? 'bg-purple-50 border-purple-300' : 'bg-gray-50 border-gray-200 opacity-60' %>">
            <div class="text-3xl mb-1"><%= user.points >= 500 ? '👑' : '🔒' %></div>
            <div class="font-bold text-sm text-gray-800">ตำนาน Health Quest</div>
            <div class="text-[10.5px] text-gray-500 mt-1">สะสม 500 แต้ม</div>
        </div>
    </div>
</div>
        <div class="grid grid-cols-2 gap-3">
            <div class="bg-white p-4 rounded-2xl shadow flex items-center gap-3">
                <span class="text-3xl">🔥</span>
                <div>
                    <div class="text-xs text-gray-400">Streak ติดต่อกัน</div>
                    <div class="font-bold text-lg text-orange-500"><%= user.current_streak %> วัน</div>
                </div>
            </div>
            <div class="bg-white p-4 rounded-2xl shadow flex items-center gap-3">
                <span class="text-3xl">⭐</span>
                <div>
                    <div class="text-xs text-gray-400">แต้มสะสมรวม</div>
                    <div class="font-bold text-lg text-yellow-500"><%= user.points %> แต้ม</div>
                </div>
            </div>
        </div>

        <!-- รายการภารกิจสุขภาพประจำวัน (บังคับอัปโหลดรูป) -->
        <div class="bg-white p-4 rounded-2xl shadow">
            <h2 class="font-bold text-gray-700 mb-3">🎯 ภารกิจประจำวัน (Daily Quests)</h2>
            <div class="space-y-4">
                <% quests.forEach(quest => { %>
                    <div class="border p-3 rounded-xl flex flex-col gap-2 bg-slate-50">
                        <div>
                            <div class="font-bold text-sm text-gray-800"><%= quest.title %></div>
                            <div class="text-xs text-gray-500"><%= quest.description %></div>
                            <span class="text-xs text-green-600 font-bold">+<%= quest.points_reward %> แต้ม</span>
                        </div>
                        <hr class="border-gray-200">
                        
                        <!-- ฟอร์มส่งงาน (มี input file บังคับอัปรูป) -->
                        <form action="/student/submit-quest" method="POST" enctype="multipart/form-data" class="flex items-center justify-between gap-2 mt-1">
                            <input type="hidden" name="quest_id" value="<%= quest.id %>">
                            <!-- เพิ่ม required บังคับต้องมีรูปถึงจะกดส่งได้ -->
                            <input type="file" name="proof_img" required accept="image/*" class="w-full text-xs text-gray-600 file:mr-2 file:py-1 file:px-2 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-indigo-100 file:text-indigo-700 hover:file:bg-indigo-200 cursor-pointer">
                            <button type="submit" class="bg-indigo-600 text-white text-xs font-bold px-4 py-2 rounded-lg hover:bg-indigo-700 transition whitespace-nowrap">ส่งงาน</button>
                        </form>

                    </div>
                <% }); %>
            </div>
        </div>

        <a href="/student/shop" class="mt-4 block w-full bg-gradient-to-r from-yellow-400 to-orange-500 text-white text-center font-extrabold py-3 rounded-2xl shadow-lg hover:opacity-90 transition">
    🛒 เข้าสู่ร้านค้า (แลกของรางวัล)
</a>

        <!-- เมนูล่าง -->
        <div class="flex gap-2">
            <a href="/leaderboard" class="flex-1 bg-yellow-400 text-center py-3 rounded-xl font-bold text-sm text-gray-800 shadow hover:bg-yellow-500 transition">🏆 ดูตารางอันดับ</a>
            <a href="/logout" class="bg-red-500 text-white px-4 py-3 rounded-xl font-bold text-sm shadow hover:bg-red-600 transition">ออกจากระบบ</a>
        </div>
    </div>
</body>
</html>