<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>กระดานจัดอันดับ - Health Quest</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-indigo-50 min-h-screen p-4 pb-12">
    <div class="max-w-md mx-auto">
        <div class="text-center mb-6 mt-4">
            <h1 class="text-3xl font-extrabold text-indigo-700">🏆 กระดานอันดับ</h1>
            <p class="text-gray-500 text-sm">นักเรียนที่มีแต้มสุขภาพสูงสุด</p>
        </div>

        <div class="bg-white rounded-3xl shadow-xl overflow-hidden">
            <% students.forEach((student, index) => { %>
                <div class="flex items-center p-4 border-b last:border-0 <%= index === 0 ? 'bg-yellow-50' : (index === 1 ? 'bg-gray-50' : (index === 2 ? 'bg-orange-50' : '')) %>">
                    <!-- อันดับ 1-3 ใส่สีพิเศษ -->
                    <div class="w-8 text-center font-bold text-lg <%= index === 0 ? 'text-yellow-500' : (index === 1 ? 'text-gray-400' : (index === 2 ? 'text-orange-500' : 'text-gray-400')) %>">
                        <%= index + 1 %>
                    </div>
                    
                    <img src="<%= student.profile_img %>" class="w-10 h-10 rounded-full border border-gray-200 object-cover mx-3">
                    
                    <div class="flex-1">
                        <div class="font-bold text-sm text-gray-800"><%= student.fullname %></div>
                        <div class="text-xs text-gray-500"><%= student.grade_level %> <%= student.room %> (Lv.<%= student.level %>)</div>
                    </div>
                    
                    <div class="font-extrabold text-indigo-600">
                        <%= student.points %> <span class="text-xs font-normal text-gray-500">แต้ม</span>
                    </div>
                </div>
            <% }); %>
            
            <% if(students.length === 0) { %>
                <div class="p-8 text-center text-gray-400 font-bold">ยังไม่มีข้อมูลนักเรียน</div>
            <% } %>
        </div>

        <div class="mt-6 text-center">
            <a href="/student/dashboard" class="inline-block bg-gray-800 text-white px-6 py-3 rounded-xl font-bold shadow-lg hover:bg-gray-700">⬅ กลับหน้าหลัก</a>
        </div>
    </div>
</body>
</html>