<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ร้านค้า - Health Quest</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-indigo-50 min-h-screen pb-12">
    <!-- Header -->
    <div class="bg-indigo-600 text-white p-4 rounded-b-3xl shadow-lg max-w-md mx-auto flex justify-between items-center">
        <h1 class="font-extrabold text-xl">🛒 ร้านค้าแลกรางวัล</h1>
        <div class="bg-indigo-800 px-3 py-1 rounded-full text-sm font-bold shadow-inner">
            แต้มของคุณ: <span class="text-yellow-400"><%= user.points %></span>
        </div>
    </div>

    <div class="max-w-md mx-auto p-4 mt-4">
        <a href="/student/dashboard" class="text-indigo-600 font-bold text-sm mb-4 inline-block hover:underline">← กลับหน้าภารกิจ</a>
        
        <div class="grid grid-cols-2 gap-4">
            <% items.forEach(item => { %>
                <div class="bg-white p-4 rounded-2xl shadow border border-gray-100 flex flex-col items-center text-center">
                    <div class="text-4xl mb-2"><%= item.icon %></div>
                    <div class="font-bold text-indigo-900 text-sm mb-1"><%= item.name %></div>
                    <div class="text-[10px] text-gray-500 mb-3 flex-1"><%= item.description %></div>
                    
                    <form action="/student/shop/buy" method="POST" class="w-full mt-auto" onsubmit="return confirm('ยืนยันการใช้ <%= item.price %> แต้ม แลกซื้อสิ่งนี้?');">
                        <input type="hidden" name="item_name" value="<%= item.name %>">
                        <input type="hidden" name="price" value="<%= item.price %>">
                        <!-- เช็กว่าแต้มพอไหม ถ้าไม่พอให้ปุ่มเป็นสีเทา -->
                        <% if (user.points >= item.price) { %>
                            <button type="submit" class="w-full bg-yellow-400 text-yellow-900 font-bold py-2 rounded-xl text-xs hover:bg-yellow-500 shadow-sm transition">
                                💎 <%= item.price %> แต้ม
                            </button>
                        <% } else { %>
                            <button type="button" class="w-full bg-gray-200 text-gray-400 font-bold py-2 rounded-xl text-xs cursor-not-allowed">
                                🔒 <%= item.price %> แต้ม
                            </button>
                        <% } %>
                    </form>
                </div>
            <% }) %>
        </div>
    </div>
</body>
</html>